<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Only launcher-visible apps, not the entire installed package inventory. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN"/>
      <category android:name="android.intent.category.LAUNCHER"/>
    </intent>
  </queries>
  <!-- INTERNET: only the optional one-time Premium promotion code check; ordinary widget operations stay offline. -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <!-- CAMERA is requested at runtime only for the optional flashlight tool. -->
  <!-- System BiometricPrompt handles fingerprints; biometric templates never enter the app. -->
  <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-feature android:name="android.hardware.camera" android:required="false"/>
  <uses-feature android:name="android.hardware.camera.flash" android:required="false"/>
  <application
    android:label="@string/app_name"
    android:icon="@drawable/varyok_app_icon"
    android:roundIcon="@drawable/varyok_app_icon"
    android:theme="@style/Theme.RaSaSeR"
    android:allowBackup="false"
    android:fullBackupContent="false"
    android:usesCleartextTraffic="false">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <!-- Picker has no exported entry or access to background app inventory. -->
    <activity android:name=".WidgetCreateActivity" android:exported="false"/>
    <activity android:name=".WidgetEditorActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
      </intent-filter>
    </activity>
    <activity android:name=".AppShortcutActivity"
        android:exported="false"
        android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
    <receiver android:name=".PinResultReceiver" android:exported="false"/>
    <activity android:name=".ActionActivity" android:exported="false"/>
    <receiver android:name=".ActionWidgetProvider" android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_info"/>
    </receiver>
  </application>
</manifest>
